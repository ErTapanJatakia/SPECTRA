{
  "name": "spectra",
  "version": "0.1.0",
  "private": true,
  "description": "SPECTRA — Global Defence Systems & Peace Operations Learning Atlas",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:content && npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts vite.config.ts playwright.config.ts eslint.config.js",
    "validate:content": "node scripts/validate-content.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:all": "npm run validate:content && npm run typecheck && npm run lint && npm run test && npm run build",
    "test:e2e:offline": "playwright test --config=playwright.offline.config.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.5.1",
    "zod": "4.6.7",
    "@react-three/fiber": "9.8.2",
    "@react-three/drei": "10.7.9",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "^8.3.0",
    "vitest": "5.1.0",
    "@types/three": "^0.187.0"
  }
}
